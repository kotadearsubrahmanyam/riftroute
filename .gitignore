# RiftRoute - .gitignore

# Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx
secrets/

# Rust build artifacts
target/
**/*.rs.bk
Cargo.lock

# Node / Frontend artifacts
node_modules/
dist/
build/
.next/
out/
.parcel-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Tauri build artifacts
src-tauri/target/

# IDE and Editor files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Temporary files and logs
logs/
*.log
tmp/
temp/
*.tmp
*.bak
*.swp
