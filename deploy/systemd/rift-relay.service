[Unit]
Description=RiftRoute Relay Diagnostic Daemon
Documentation=https://github.com/riftroute/riftroute
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=riftroute
Group=riftroute
WorkingDirectory=/etc/riftroute
ExecStart=/usr/local/bin/rift-relay run --config /etc/riftroute/config.json
Restart=on-failure
RestartSec=5s

# Security Hardening Directives
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=CAP_NET_RAW
AmbientCapabilities=CAP_NET_RAW
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# Read-only configuration with writable log area
ReadOnlyPaths=/etc/riftroute
ReadWritePaths=/var/log/riftroute /tmp

# Resource Limits
LimitNOFILE=8192
LimitNPROC=512

[Install]
WantedBy=multi-user.target
